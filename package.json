{
    "name": "deepcommits",
    "displayName": "DeepCommits",
    "description": "Generate Git commit messages from your staged changes using the DeepSeek API.",
    "version": "0.1.1",
    "publisher": "etherener",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "SCM Providers",
        "Other"
    ],
    "keywords": [
        "git",
        "commit",
        "deepseek",
        "ai"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "icon": "assets/icon.png",
    "contributes": {
        "commands": [
            {
                "command": "deepcommits.generateCommitMessage",
                "title": "DeepCommits: Generate Commit Message",
                "icon": "$(sparkle)"
            },
            {
                "command": "deepcommits.clearApiKey",
                "title": "DeepCommits: Clear Stored API Key"
            },
            {
                "command": "deepcommits.openPanel",
                "title": "DeepCommits: Open Panel",
                "icon": "$(sparkle)"
            },
            {
                "command": "deepcommits.generateAndCommit",
                "title": "DeepCommits: Generate and Commit Instantly"
            }
        ],
        "menus": {
            "scm/title": [
                {
                    "command": "deepcommits.generateCommitMessage",
                    "when": "scmProvider == git",
                    "group": "navigation"
                },
                {
                    "command": "deepcommits.openPanel",
                    "when": "scmProvider == git",
                    "group": "navigation"
                }
            ]
        },
        "keybindings": [
            {
                "command": "deepcommits.generateAndCommit",
                "key": "ctrl+alt+m",
                "mac": "cmd+alt+m"
            }
        ],
        "configuration": {
            "title": "DeepCommits",
            "properties": {
                "deepcommits.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "DeepSeek API key. If empty, DeepCommits will prompt for it and store it securely."
                },
                "deepcommits.model": {
                    "type": "string",
                    "default": "deepseek-chat",
                    "description": "DeepSeek model used to generate commit messages."
                },
                "deepcommits.language": {
                    "type": "string",
                    "default": "en",
                    "description": "Language for the generated commit message (e.g. 'en', 'es')."
                },
                "deepcommits.commitConvention": {
                    "type": "string",
                    "enum": [
                        "conventional",
                        "freeform"
                    ],
                    "default": "conventional",
                    "description": "Whether to enforce Conventional Commits format."
                },
                "deepcommits.customInstructions": {
                    "type": "string",
                    "default": "",
                    "description": "Custom style instructions for the AI, applied on top of the commit convention (e.g. 'always mention the affected module in parentheses'). Capped at 200 characters to keep token usage low."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "lint": "eslint src --ext ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "package:vsix": "vsce package --no-dependencies"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/vscode": "^1.85.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@vscode/vsce": "^4.0.0",
        "eslint": "^8.56.0",
        "ts-loader": "^9.5.1",
        "typescript": "^5.3.3",
        "vitest": "^5.0.2",
        "webpack": "^5.90.0",
        "webpack-cli": "^5.1.4"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/devEthan6737/deepcommits.git"
    },
    "license": "MIT"
}
